    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@uiw/react-codemirror": "^4.25.11",
    "dotenv": "^17.4.2",
    "firebase": "^12.15.0",
    "firebase-admin": "13.10.0",
    "next": "16.2.9",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-activity-heatmap": "^2.0.1",
